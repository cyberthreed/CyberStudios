  "tokenColors": [
    {
      "settings": {
        "foreground": "#E6E9DE",
        "background": "#141E19",
        "fontStyle": ""
      }
    },
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#A1AF9D",
        "fontStyle": ""
      }
    },
    {
      "name": "Documentation tags",
      "scope": [
        "storage.type.class.jsdoc",
        "storage.type.class.python",
        "entity.name.type.instance.jsdoc",
        "keyword.other.documentation"
      ],
      "settings": {
        "foreground": "#A8B7CF",
        "fontStyle": ""
      }
    },
    {
      "name": "Keywords and declarations",
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#C9C395",
        "fontStyle": ""
      }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator",
        "punctuation.accessor",
        "punctuation.separator.key-value"
      ],
      "settings": {
        "foreground": "#C9C395",
        "fontStyle": ""
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#B8CFA5",
        "fontStyle": ""
      }
    },
    {
      "name": "Template interpolation punctuation",
      "scope": [
        "punctuation.definition.template-expression",
        "punctuation.section.embedded"
      ],
      "settings": {
        "foreground": "#C9C395",
        "fontStyle": ""
      }
    },
    {
      "name": "Template expressions",
      "scope": [
        "meta.template.expression"
      ],
      "settings": {
        "foreground": "#E6E9DE",
        "fontStyle": ""
      }
    },
    {
      "name": "Escapes and regular expressions",
      "scope": [
        "constant.character.escape",
        "string.regexp",
        "constant.other.character-class",
        "keyword.operator.quantifier.regexp"
      ],
      "settings": {
        "foreground": "#DCB493",
        "fontStyle": ""
      }
    },
    {
      "name": "Numbers and language constants",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character",
        "support.constant",
        "variable.other.constant",
        "variable.other.enummember"
      ],
      "settings": {
        "foreground": "#DCB493",
        "fontStyle": ""
      }
    },
    {
      "name": "Functions and methods",
      "scope": [
        "entity.name.function",
        "support.function",
        "variable.function",
        "meta.function-call entity.name.function",
        "meta.function-call.generic"
      ],
      "settings": {
        "foreground": "#A8C7C4",
        "fontStyle": ""
      }
    },
    {
      "name": "Types and namespaces",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.namespace",
        "entity.name.scope-resolution",
        "support.type",
        "support.class",
        "storage.type.primitive",
        "storage.type.built-in"
      ],
      "settings": {
        "foreground": "#A8B7CF",
        "fontStyle": ""
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable",
        "meta.definition.variable.name"
      ],
      "settings": {
        "foreground": "#E6E9DE",
        "fontStyle": ""
      }
    },
