  "tokenColors": [
    {
      "settings": {
        "foreground": "#183E4D",
        "background": "#F2FAFD",
        "fontStyle": ""
      }
    },
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#536D79",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Documentation tags",
      "scope": [
        "storage.type.class.jsdoc",
        "storage.type.class.python",
        "entity.name.type.instance.jsdoc",
        "keyword.other.documentation"
      ],
      "settings": {
        "foreground": "#0A6877",
        "fontStyle": ""
      }
    },
    {
      "name": "Keywords and declarations",
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#59429A",
        "fontStyle": ""
      }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator",
        "punctuation.accessor",
        "punctuation.separator.key-value"
      ],
      "settings": {
        "foreground": "#59429A",
        "fontStyle": ""
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#216652",
        "fontStyle": ""
      }
    },
    {
      "name": "Template interpolation punctuation",
      "scope": [
        "punctuation.definition.template-expression",
        "punctuation.section.embedded"
      ],
      "settings": {
        "foreground": "#59429A",
        "fontStyle": ""
      }
    },
    {
      "name": "Template expressions",
      "scope": [
        "meta.template.expression"
      ],
      "settings": {
        "foreground": "#183E4D",
        "fontStyle": ""
      }
    },
    {
      "name": "Escapes and regular expressions",
      "scope": [
        "constant.character.escape",
        "string.regexp",
        "constant.other.character-class",
        "keyword.operator.quantifier.regexp"
      ],
      "settings": {
        "foreground": "#905127",
        "fontStyle": ""
      }
    },
    {
      "name": "Numbers and language constants",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character",
        "support.constant",
        "variable.other.constant",
        "variable.other.enummember"
      ],
      "settings": {
        "foreground": "#905127",
        "fontStyle": ""
      }
    },
    {
      "name": "Functions and methods",
      "scope": [
        "entity.name.function",
        "support.function",
        "variable.function",
        "meta.function-call entity.name.function",
        "meta.function-call.generic"
      ],
      "settings": {
        "foreground": "#155B91",
        "fontStyle": ""
      }
    },
    {
      "name": "Types and namespaces",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.namespace",
        "entity.name.scope-resolution",
        "support.type",
        "support.class",
        "storage.type.primitive",
        "storage.type.built-in"
      ],
      "settings": {
        "foreground": "#0A6877",
        "fontStyle": ""
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable",
        "meta.definition.variable.name"
      ],
      "settings": {
        "foreground": "#183E4D",
        "fontStyle": ""
      }
    },
    {
      "name": "Properties and members",
      "scope": [
        "variable.other.property",
        "variable.object.property",
        "support.variable.property",
        "support.type.property-name",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#294C5E",
        "fontStyle": ""
      }
    },
    {
      "name": "Parameters",
      "scope": [
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#294C5E",
        "fontStyle": ""
      }
    },
    {
      "name": "Built-in variables",
      "scope": [
        "variable.language",
        "support.variable"
      ],
      "settings": {
        "foreground": "#0A6877",
        "fontStyle": ""
      }
    },
    {
      "name": "Decorators and annotations",
      "scope": [
