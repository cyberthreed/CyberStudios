  "tokenColors": [
    {
      "settings": {
        "foreground": "#303B3D",
        "background": "#F3F2ED",
        "fontStyle": ""
      }
    },
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#55635F",
        "fontStyle": ""
      }
    },
    {
      "name": "Documentation tags",
      "scope": [
        "storage.type.class.jsdoc",
        "storage.type.class.python",
        "entity.name.type.instance.jsdoc",
        "keyword.other.documentation"
      ],
      "settings": {
        "foreground": "#4A5D73",
        "fontStyle": ""
      }
    },
    {
      "name": "Keywords and declarations",
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#7E4937",
        "fontStyle": ""
      }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator",
        "punctuation.accessor",
        "punctuation.separator.key-value"
      ],
      "settings": {
        "foreground": "#7E4937",
        "fontStyle": ""
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#466247",
        "fontStyle": ""
      }
    },
    {
      "name": "Template interpolation punctuation",
      "scope": [
        "punctuation.definition.template-expression",
        "punctuation.section.embedded"
      ],
      "settings": {
        "foreground": "#7E4937",
        "fontStyle": ""
      }
    },
    {
      "name": "Template expressions",
      "scope": [
        "meta.template.expression"
      ],
      "settings": {
        "foreground": "#303B3D",
        "fontStyle": ""
      }
    },
    {
      "name": "Escapes and regular expressions",
      "scope": [
        "constant.character.escape",
        "string.regexp",
        "constant.other.character-class",
        "keyword.operator.quantifier.regexp"
      ],
      "settings": {
        "foreground": "#865432",
        "fontStyle": ""
      }
    },
    {
      "name": "Numbers and language constants",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character",
        "support.constant",
        "variable.other.constant",
        "variable.other.enummember"
      ],
      "settings": {
        "foreground": "#865432",
        "fontStyle": ""
      }
    },
    {
      "name": "Functions and methods",
      "scope": [
        "entity.name.function",
        "support.function",
        "variable.function",
        "meta.function-call entity.name.function",
        "meta.function-call.generic"
      ],
      "settings": {
        "foreground": "#355E75",
        "fontStyle": ""
      }
    },
    {
      "name": "Types and namespaces",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.namespace",
        "entity.name.scope-resolution",
        "support.type",
        "support.class",
        "storage.type.primitive",
        "storage.type.built-in"
      ],
      "settings": {
        "foreground": "#4A5D73",
        "fontStyle": ""
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable",
        "meta.definition.variable.name"
      ],
      "settings": {
        "foreground": "#303B3D",
        "fontStyle": ""
      }
    },
    {
      "name": "Properties and members",
      "scope": [
        "variable.other.property",
        "variable.object.property",
        "support.variable.property",
        "support.type.property-name",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#454E4F",
        "fontStyle": ""
      }
    },
    {
      "name": "Parameters",
      "scope": [
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#454E4F",
        "fontStyle": ""
      }
    },
    {
      "name": "Built-in variables",
      "scope": [
